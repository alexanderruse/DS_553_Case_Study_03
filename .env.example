# Copy this file to .env and replace every CHANGE_ME value.
# Use five ports from the range your group claimed in the class Google Sheet.
COMPOSE_PROJECT_NAME=groupCHANGE_ME_resumelens
API_UI_PORT=CHANGE_ME
LOCAL_UI_PORT=CHANGE_ME
PROMETHEUS_PORT=CHANGE_ME
GRAFANA_PORT=CHANGE_ME
PUBLIC_GATEWAY_PORT=CHANGE_ME

# Docker Hub names are lowercase. Example: alexakrett/resumelens-cs3
DOCKERHUB_USERNAME=CHANGE_ME
IMAGE_TAG=v1

# Never commit this token. The API container reads it from the server environment.
HF_TOKEN=CHANGE_ME
REMOTE_MODEL=openai/gpt-oss-20b
LOCAL_MODEL=Qwen/Qwen3-0.6B

# Leave this as localhost for initial testing. start_ngrok.sh temporarily restarts
# Grafana with the public ngrok address after the tunnel is created.
PUBLIC_BASE_URL=http://localhost:CHANGE_ME

# Change before starting Grafana. Do not use this example password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
